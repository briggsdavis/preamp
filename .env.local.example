# Copy this file to `.env.local` and fill in the values.
# `npx convex dev` will populate the Convex variables automatically.

# The deployment URL of your Convex backend (set by `npx convex dev`).
VITE_CONVEX_URL=

# Used by `npx convex dev` to target the right deployment.
CONVEX_DEPLOYMENT=

# Production origin used by the SEO prerender step (scripts/prerender.mjs) for
# absolute canonical/Open Graph URLs and sitemap.xml. Optional locally; set it
# in your production build env (e.g. https://preampcoffee.com).
VITE_SITE_URL=
